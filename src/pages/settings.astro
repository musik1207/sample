---
import Base from '../layouts/Base.astro';
import { certs, displayName } from '../lib/data';

const names = Object.fromEntries(certs.map((c) => [c.id, displayName(c)]));
---

<Base title="記録と設定" nav="settings">
  <h1>記録と設定</h1>
  <p class="muted">学習記録はこのブラウザの中だけに保存されています。別の端末やブラウザで続けるときは、書き出したファイルを読み込んでください。</p>

  <section class="card" aria-labelledby="display-title">
    <h2 id="display-title">表示</h2>
    <div class="setting">
      <span class="setting-label" id="theme-label">テーマ</span>
      <div class="segmented" role="radiogroup" aria-labelledby="theme-label">
        <label><input type="radio" name="theme" value="auto" /><span>端末に合わせる</span></label>
        <label><input type="radio" name="theme" value="light" /><span>ライト</span></label>
        <label><input type="radio" name="theme" value="dark" /><span>ダーク</span></label>
      </div>
    </div>
    <div class="setting">
      <span class="setting-label" id="size-label">文字の大きさ</span>
      <div class="segmented" role="radiogroup" aria-labelledby="size-label">
        <label><input type="radio" name="size" value="normal" /><span>標準</span></label>
        <label><input type="radio" name="size" value="large" /><span>大きめ</span></label>
      </div>
    </div>
  </section>

  <section class="card" aria-labelledby="app-title">
    <h2 id="app-title">ホーム画面のアプリ</h2>
    <p class="app-state" id="app-state">確認しています…</p>
    <div id="install-help" hidden>
      <p class="small">iPhone では、ホーム画面に追加するとアプリのように全画面で使えます。</p>
      <ol class="small steps">
        <li>Safari でこのサイトを開き、<strong>共有ボタン</strong>（四角から上向きの矢印）をタップします。</li>
        <li><strong>「ホーム画面に追加」</strong>を選びます。「Web アプリとして開く」が表示されたら、オンのままにします。</li>
        <li>名前が「資格マップ」になっていることを確かめて、<strong>「追加」</strong>をタップします。</li>
      </ol>
    </div>
    <p class="small notice" id="storage-note" hidden>
      ホーム画面のアプリと Safari では、学習記録が<strong>別々に</strong>保存されます。Safari で学習していた場合は、Safari 側の「記録を引き継ぐ」で記録をコピーし、アプリ側で貼り付けて読み込んでください。
    </p>

    <h3 class="sub">オフライン用に保存</h3>
    <p class="small muted">
      全ページと教材を端末に保存して、電波のない場所でも学習できるようにします<span id="offline-size"></span>。一度開いたページは自動でも保存されます。
    </p>
    <div class="btn-row">
      <button class="btn btn-primary" type="button" id="offline-save">オフライン用に保存</button>
      <button class="btn btn-ghost" type="button" id="offline-clear" hidden>保存したデータを削除</button>
    </div>
    <div class="progress offline-progress" id="offline-progress" hidden aria-hidden="true"><span></span></div>
    <p class="small offline-status" id="offline-status" role="status"></p>
  </section>

  <section class="card" aria-labelledby="summary-title">
    <h2 id="summary-title">学習記録</h2>
    <div class="stats" id="summary"></div>
    <p class="small muted updated" id="updated"></p>
  </section>

  <section class="card" aria-labelledby="io-title">
    <h2 id="io-title">書き出し・読み込み</h2>
    <p class="small muted">端末を変えるときや、念のための保存に使います。</p>
    <div class="btn-row">
      <button class="btn btn-primary" type="button" id="export">ファイルに書き出す</button>
      <label class="btn" for="import">ファイルを読み込む</label>
      <input type="file" id="import" accept="application/json,.json" class="visually-hidden" />
    </div>
    <details class="transfer">
      <summary>記録を引き継ぐ（コピーと貼り付け）</summary>
      <p class="small muted">Safari とホーム画面のアプリの間など、同じ端末の中で記録を移すときに便利です。</p>
      <div class="btn-row">
        <button class="btn" type="button" id="copy">記録をコピー</button>
      </div>
      <label class="small paste-label" for="paste">コピーした記録をここに貼り付けて、「貼り付けた記録を読み込む」を押します。</label>
      <textarea id="paste" rows="3" spellcheck="false" autocomplete="off"></textarea>
      <div class="btn-row">
        <button class="btn" type="button" id="paste-import">貼り付けた記録を読み込む</button>
      </div>
    </details>
    <p class="small message" id="message" role="status"></p>
  </section>

  <section class="card" aria-labelledby="mocks-title">
    <h2 id="mocks-title">模擬試験の履歴</h2>
    <div id="mocks"></div>
  </section>

  <section class="card danger-zone" aria-labelledby="reset-title">
    <h2 id="reset-title">記録の削除</h2>
    <p class="small muted">すべての学習記録を消します。元に戻せないので、先に書き出しておくことをおすすめします。</p>
    <button class="btn btn-danger" type="button" id="reset">すべての記録を削除</button>
  </section>

  <script type="application/json" id="names" set:html={JSON.stringify(names)} />
  <script>
    import { exportProgress, importProgress, loadPrefs, loadProgress, resetProgress, savePrefs, type DisplayPrefs } from '../lib/storage';
    import { readJson, studyStreak } from '../lib/progress';
    import { clearOffline, isIOS, isStandalone, offlineStatus, saveAllForOffline } from '../lib/pwa';

    const names = readJson<Record<string, string>>('names');
    const message = document.getElementById('message')!;

    // 表示の設定
    const prefs = loadPrefs();
    for (const name of ['theme', 'size'] as const) {
      document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((input) => {
        input.checked = input.value === prefs[name];
        input.addEventListener('change', () => {
          const next = { ...prefs, [name]: input.value } as DisplayPrefs;
          Object.assign(prefs, next);
          savePrefs(next);
        });
      });
    }

    function render() {
      const d = loadProgress();
      const stats = Object.values(d.questions);
      const { streak } = studyStreak(d.activity);
      const tile = (label: string, value: number, unit: string) =>
        `<div class="stat"><span class="stat-label">${label}</span><span class="stat-value">${value}<small>${unit}</small></span></div>`;
      document.getElementById('summary')!.innerHTML = [
        tile('読了レッスン', Object.keys(d.lessons).length, '件'),
        tile('解いた問題', stats.length, '問'),
        tile('のべ回答', stats.reduce((s, q) => s + q.attempts, 0), '回'),
        tile('復習待ち', stats.filter((q) => q.inReview).length, '問'),
        tile('模擬試験', d.mocks.length, '回'),
        tile('連続学習', streak, '日'),
      ].join('');
      document.getElementById('updated')!.textContent = `最終更新: ${new Date(d.updatedAt).toLocaleString('ja-JP')}`;
      const mocks = d.mocks.slice().reverse();
      document.getElementById('mocks')!.innerHTML = mocks.length
        ? `<div class="table-wrap"><table><thead><tr><th>日時</th><th>資格</th><th>結果</th><th>時間</th></tr></thead><tbody>${mocks
            .map(
              (m) =>
                `<tr><td>${new Date(m.date).toLocaleString('ja-JP')}</td><td>${names[m.certId] ?? m.certId}</td><td>${Math.round((m.score / m.total) * 100)}%（${m.score}/${m.total}）</td><td>${Math.floor(m.durationSec / 60)} 分</td></tr>`,
            )
            .join('')}</tbody></table></div>`
        : '<p class="small muted">まだありません。資格ページの「模擬試験」から受けられます。</p>';
    }

    document.getElementById('export')!.addEventListener('click', () => {
      const blob = new Blob([exportProgress()], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `sf-study-progress-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
      message.textContent = '書き出しました。';
    });

    document.getElementById('import')!.addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      if (!window.confirm('今の記録を、読み込むファイルの内容で置き換えます。よろしいですか？')) {
        input.value = '';
        return;
      }
      try {
        importProgress(await file.text());
        message.textContent = '読み込みました。';
        render();
      } catch (err) {
        message.textContent = `読み込めませんでした: ${err instanceof Error ? err.message : String(err)}`;
      }
      input.value = '';
    });

    // 記録の引き継ぎ（コピーと貼り付け）
    const paste = document.getElementById('paste') as HTMLTextAreaElement;
    document.getElementById('copy')!.addEventListener('click', async () => {
      const json = exportProgress();
      try {
        await navigator.clipboard.writeText(json);
        message.textContent = '記録をコピーしました。引き継ぎ先で貼り付けてください。';
      } catch {
        // コピーできない環境では、選択した状態で見せて手でコピーしてもらう
        paste.value = json;
        paste.select();
        message.textContent = 'コピーできなかったので、下の欄の内容を選択しました。長押しでコピーしてください。';
      }
    });
    document.getElementById('paste-import')!.addEventListener('click', () => {
      if (!paste.value.trim()) {
        message.textContent = '貼り付ける欄が空です。';
        return;
      }
      if (!window.confirm('今の記録を、貼り付けた内容で置き換えます。よろしいですか？')) return;
      try {
        importProgress(paste.value);
        paste.value = '';
        message.textContent = '読み込みました。';
        render();
      } catch (err) {
        message.textContent = `読み込めませんでした: ${err instanceof Error ? err.message : String(err)}`;
      }
    });

    // ホーム画面のアプリとオフライン保存
    const appState = document.getElementById('app-state')!;
    const offlineStatusEl = document.getElementById('offline-status')!;
    const saveBtn = document.getElementById('offline-save') as HTMLButtonElement;
    const clearBtn = document.getElementById('offline-clear') as HTMLButtonElement;
    const progress = document.getElementById('offline-progress')!;
    const standalone = isStandalone();
    appState.textContent = standalone
      ? '✓ ホーム画面のアプリとして開いています。'
      : 'いまはブラウザで開いています。';
    document.getElementById('install-help')!.hidden = standalone;
    document.getElementById('storage-note')!.hidden = !isIOS();

    fetch(`${import.meta.env.BASE_URL}precache.json`, { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((list: { bytes: number } | null) => {
        if (list) document.getElementById('offline-size')!.textContent = `（約 ${Math.max(1, Math.round(list.bytes / 1024 / 1024))} MB）`;
      })
      .catch(() => {});

    async function renderOffline() {
      const s = await offlineStatus();
      if (!s) {
        saveBtn.disabled = true;
        offlineStatusEl.textContent = 'この環境ではオフライン保存を使えません（一度ページを読み込み直すと使えるようになることがあります）。';
        return;
      }
      saveBtn.disabled = false;
      clearBtn.hidden = !s.saved && s.pages === 0;
      if (s.saved) {
        saveBtn.textContent = s.upToDate ? 'もう一度保存し直す' : '最新の教材に更新する';
        offlineStatusEl.textContent = `${s.upToDate ? '✓ 保存済み' : '保存済み（新しい教材があります）'}：${new Date(s.savedAt!).toLocaleString('ja-JP')}`;
      } else {
        saveBtn.textContent = 'オフライン用に保存';
        offlineStatusEl.textContent = s.pages ? `開いたことのある ${s.pages} ページは保存されています。` : '';
      }
    }
    saveBtn.addEventListener('click', async () => {
      saveBtn.disabled = true;
      progress.hidden = false;
      const bar = progress.querySelector('span')!;
      try {
        const r = await saveAllForOffline((done, total) => {
          bar.style.width = `${Math.round((done / total) * 100)}%`;
          offlineStatusEl.textContent = `保存しています… ${done} / ${total}`;
        });
        await renderOffline();
        if (r.failed) offlineStatusEl.textContent += `（${r.failed} 件は保存できませんでした。電波の良い場所でもう一度お試しください）`;
      } catch (err) {
        offlineStatusEl.textContent = `保存できませんでした: ${err instanceof Error ? err.message : String(err)}`;
        saveBtn.disabled = false;
      }
      progress.hidden = true;
    });
    clearBtn.addEventListener('click', async () => {
      if (!window.confirm('オフライン用に保存したページとファイルを削除します（学習記録は消えません）。よろしいですか？')) return;
      await clearOffline().catch(() => {});
      await renderOffline();
    });
    renderOffline();

    document.getElementById('reset')!.addEventListener('click', () => {
      if (!window.confirm('すべての学習記録を削除します。元に戻せません。よろしいですか？')) return;
      resetProgress();
      message.textContent = '';
      render();
    });

    render();
  </script>
</Base>

<style>
  section.card {
    margin-top: 16px;
  }
  section.card h2 {
    font-size: 1.05rem;
    margin: 0 0 12px;
  }
  .setting {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 8px 0;
  }
  .setting + .setting {
    border-top: 1px solid var(--border);
    padding-top: 14px;
  }
  .setting-label {
    font-weight: 600;
  }
  .updated {
    margin: 10px 0 0;
  }
  .message:empty {
    display: none;
  }
  .app-state {
    margin: 0 0 8px;
    font-weight: 600;
  }
  .steps {
    padding-left: 1.4em;
    margin: 8px 0 12px;
  }
  .steps li + li {
    margin-top: 4px;
  }
  .sub {
    font-size: 0.95rem;
    margin: 20px 0 4px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .offline-progress {
    margin-top: 12px;
  }
  .offline-status {
    margin: 8px 0 0;
  }
  .offline-status:empty {
    display: none;
  }
  .transfer {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .transfer summary {
    font-weight: 600;
    color: var(--text-muted);
  }
  .transfer[open] summary {
    margin-bottom: 8px;
  }
  .paste-label {
    display: block;
    margin: 12px 0 4px;
  }
  .transfer textarea {
    width: 100%;
    font: inherit;
    font-size: 16px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    margin-bottom: 8px;
  }
  .danger-zone {
    border-color: color-mix(in srgb, var(--danger) 40%, var(--border));
  }
</style>
