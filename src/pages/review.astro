---
import Base from '../layouts/Base.astro';
import { certs, displayName, getAllQuestions, getCases, url } from '../lib/data';
import '../styles/quiz.css';

// 範囲 ID は資格をまたぐと重複しうるので、資格 ID を付けて一意にする
const payload = {
  questions: getAllQuestions().map((q) => ({ ...q, domain: `${q.certId}:${q.domain}` })),
  domains: certs.flatMap((c) => c.domains.map((d) => ({ id: `${c.id}:${d.id}`, name: d.name, weight: d.weight }))),
  certs: certs.map((c) => ({ id: c.id, name: displayName(c) })),
  cases: Object.assign({}, ...certs.map((c) => getCases(c.id))),
};
---

<Base title="復習" nav="review">
  <div id="intro">
    <h1>復習</h1>
    <p class="muted">
      間違えた問題が自動で集まり、<strong>翌日・3 日後・1 週間後…</strong>と間をあけて出てきます。間をあけて<strong>2 回続けて正解</strong>すると、リストから外れます。
    </p>
  </div>

  <section class="card empty" id="empty" hidden>
    <div class="empty-icon" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </div>
    <h2>復習待ちの問題はありません</h2>
    <p class="muted">練習問題や模擬試験で間違えた問題が、ここに自動で集まります。</p>
    <div class="btn-row">
      <a class="btn btn-primary" id="empty-cta" href={url()}>ロードマップへ</a>
    </div>
  </section>

  <section id="picker" hidden>
    <div class="card start">
      <div>
        <p class="start-count">今日の復習 <strong id="due">0</strong> 問</p>
        <p class="small muted start-sub" id="total-line"></p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" id="start-due" href="?cert=all&due=1">今日の復習を始める</a>
        <a class="btn" href="?cert=all">復習待ちをすべて解く</a>
      </div>
    </div>
    <h2 class="section-title">資格ごとに復習する</h2>
    <ul class="list" id="cert-list"></ul>
  </section>

  <div id="quiz"></div>

  <script type="application/json" id="quiz-data" set:html={JSON.stringify(payload)} />
  <script>
    import type { CaseStudy, QuizQuestion } from '../lib/types';
    import { isDue, loadProgress } from '../lib/storage';
    import { readJson } from '../lib/progress';
    import { runQuiz, type DomainInfo } from '../lib/quiz-runner';

    const data = readJson<{
      questions: QuizQuestion[];
      domains: DomainInfo[];
      certs: { id: string; name: string }[];
      cases: Record<string, CaseStudy>;
    }>('quiz-data');
    const progress = loadProgress();
    const targets = data.questions.filter((q) => progress.questions[q.id]?.inReview);
    const dueTargets = targets.filter((q) => isDue(progress.questions[q.id]));
    const home = import.meta.env.BASE_URL;
    const reviewHref = `${home}review/`;
    const $ = (id: string) => document.getElementById(id)!;
    const params = new URLSearchParams(location.search);
    const certParam = params.get('cert');
    const dueOnly = params.get('due') === '1';

    if (!targets.length) {
      $('empty').hidden = false;
      // まだ合格していない最初の資格の演習へ案内する
      const current = data.certs.find((c) => !progress.plans[c.id]?.passedDate);
      if (current) {
        const cta = $('empty-cta') as HTMLAnchorElement;
        cta.href = `${home}certs/${current.id}/quiz/?mode=all`;
        cta.textContent = `${current.name} の練習問題へ`;
      }
    } else if (certParam) {
      const pool = dueOnly ? dueTargets : targets;
      const list = certParam === 'all' ? pool : pool.filter((q) => q.certId === certParam);
      const name = data.certs.find((c) => c.id === certParam)?.name;
      $('intro').hidden = true;
      runQuiz({
        root: $('quiz'),
        mode: 'practice',
        questions: list,
        domains: data.domains,
        cases: data.cases,
        title: `${dueOnly ? '今日の復習' : '復習'}${name ? `: ${name}` : ''}（${list.length} 問）`,
        backHref: reviewHref,
        backLabel: '復習の一覧へ',
      });
    } else {
      $('picker').hidden = false;
      $('due').textContent = String(dueTargets.length);
      $('total-line').textContent = `復習待ちは全部で ${targets.length} 問（残りは後日に出てきます）`;
      if (!dueTargets.length) {
        const a = $('start-due') as HTMLAnchorElement;
        a.removeAttribute('href');
        a.classList.add('is-disabled');
        a.textContent = '今日の復習は終わりました';
      }
      const counts = new Map<string, { due: number; all: number }>();
      for (const q of targets) {
        const c = counts.get(q.certId) ?? { due: 0, all: 0 };
        c.all++;
        if (isDue(progress.questions[q.id])) c.due++;
        counts.set(q.certId, c);
      }
      $('cert-list').innerHTML = data.certs
        .filter((c) => counts.has(c.id))
        .map((c) => {
          const n = counts.get(c.id)!;
          return `<li class="row-link review-row">
            <a class="stretched" href="?cert=${c.id}${n.due ? '&due=1' : ''}">${c.name}</a>
            ${n.due ? `<span class="tag tag-danger">今日 ${n.due} 問</span>` : ''}
            <span class="tag">全 ${n.all} 問</span>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </li>`;
        })
        .join('');
    }
  </script>
</Base>

<style>
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }
  .start-count {
    margin: 0;
    font-size: 1.05rem;
  }
  .start-count strong {
    font-size: 1.6rem;
    margin: 0 2px;
  }
  .start-sub {
    margin: 0;
  }
  .start :global(.is-disabled) {
    opacity: 0.55;
    pointer-events: none;
  }
  .empty {
    margin-top: 16px;
  }
  #cert-list :global(.review-row) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 16px;
  }
  #cert-list :global(.review-row .stretched) {
    flex: 1;
    font-weight: 600;
  }
</style>
