---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { domainBreakdown, formatHours, getCert, getQuestions, lessonStats, url } from '../../../lib/data';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { id: lesson.data.cert, domain: lesson.data.domain },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const cert = getCert(lesson.data.cert)!;
const domainIndex = cert.domains.findIndex((d) => d.id === lesson.data.domain);
const domain = cert.domains[domainIndex];
const lessons = await getCollection('lessons', (l) => l.data.cert === cert.id);
const hasLesson = (id: string) => lessons.some((l) => l.data.domain === id);
const prev = cert.domains.slice(0, domainIndex).reverse().find((d) => hasLesson(d.id));
const next = cert.domains.slice(domainIndex + 1).find((d) => hasLesson(d.id));
const qCount = getQuestions(cert.id).filter((q) => q.domain === domain.id).length;
const { Content, headings } = await render(lesson);
const toc = headings.filter((h) => h.depth === 2);
const study = domainBreakdown(cert, domain.id, lessonStats(lesson.body ?? ''));
const shortName = cert.name.replace('Salesforce Certified ', '');
---

<Base title={`${domain.name} - ${shortName}`}>
  <nav class="breadcrumb">
    <a href={url()}>ロードマップ</a> › <a href={url(`certs/${cert.id}/`)}>{shortName}</a>
  </nav>
  <header class="lesson-head">
    <p class="muted small">{domain.nameEn}{domain.weight !== null && ` ・ 配点 ${domain.weight}%`}</p>
    <h1>{domain.name}</h1>
    <p class="lead">{lesson.data.summary}</p>
    <div class="study card">
      <p class="study-total">
        学習時間の目安: <strong>約 {study.totalHours === null ? '—' : formatHours(study.totalHours)}</strong>
      </p>
      <ul class="small study-list">
        <li>レッスンを読む: 約 {study.readMinutes} 分</li>
        {study.handsOnMinutes > 0 && <li>やってみよう（ハンズオン）: 約 {study.handsOnMinutes} 分</li>}
        {study.questions > 0 && <li>練習問題 {study.questions} 問: 約 {study.practiceMinutes} 分</li>}
        {study.otherMinutes !== null && study.otherMinutes > 0 && (
          <li>問題の 2 周目以降・復習・Trailhead・実機での練習: 約 {formatHours(Math.round(study.otherMinutes / 30) / 2 || 0.5)}</li>
        )}
      </ul>
      <p class="small muted">資格全体の目安（{cert.study?.hours} 時間）を配点で割り振った値です。</p>
    </div>
  </header>

  {
    toc.length > 2 && (
      <details class="card toc" open>
        <summary>このレッスンの内容</summary>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )
  }

  {
    domain.objectives && domain.objectives.length > 0 && (
      <details class="card objectives">
        <summary>公式試験ガイドの出題目標（{domain.objectives.length} 項目）</summary>
        <ol>
          {domain.objectives.map((o) => (
            <li>{o}</li>
          ))}
        </ol>
        <p class="small muted">試験ガイドの英文を日本語に訳したものです。レッスンはこの目標に沿って構成しています。</p>
      </details>
    )
  }

  <article class="card lesson">
    <Content />
  </article>

  <div class="card actions" data-cert={cert.id} data-domain={domain.id}>
    <label class="done-toggle">
      <input type="checkbox" id="done" />
      <span>このレッスンを読み終えた</span>
    </label>
    <div class="btn-row">
      {
        qCount > 0 && (
          <a class="btn btn-primary" href={url(`certs/${cert.id}/quiz/?domain=${domain.id}`)}>
            この範囲の練習問題（{qCount} 問）
          </a>
        )
      }
    </div>
  </div>

  <nav class="pager" aria-label="レッスン">
    {prev ? <a class="btn" href={url(`certs/${cert.id}/${prev.id}/`)}>← {prev.name}</a> : <span />}
    {next && <a class="btn" href={url(`certs/${cert.id}/${next.id}/`)}>{next.name} →</a>}
  </nav>

  <script>
    import { isLessonDone, loadProgress, setLessonDone } from '../../../lib/storage';
    const box = document.querySelector<HTMLElement>('[data-cert]')!;
    const certId = box.dataset.cert!;
    const domainId = box.dataset.domain!;
    const input = document.getElementById('done') as HTMLInputElement;
    input.checked = isLessonDone(loadProgress(), certId, domainId);
    input.addEventListener('change', () => setLessonDone(certId, domainId, input.checked));
  </script>
  <script>
    import { renderDiagrams } from '../../../lib/diagrams';
    renderDiagrams(document.querySelector('.lesson') ?? document);
  </script>
</Base>

<style>
  .lesson-head .lead {
    font-size: 1.05rem;
  }
  .lesson-head p {
    margin: 0 0 8px;
  }
  .lesson {
    margin: 16px 0;
    overflow-wrap: anywhere;
  }
  .lesson :global(h2) {
    font-size: 1.2rem;
    margin-top: 2rem;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }
  .lesson :global(h2:first-child) {
    margin-top: 0;
  }
  .lesson :global(h3) {
    font-size: 1.05rem;
  }
  .lesson :global(table) {
    display: block;
    overflow-x: auto;
    margin: 12px 0;
  }
  .lesson :global(blockquote) {
    margin: 16px 0;
    padding: 12px 16px;
    background: var(--accent-soft);
    border-left: 4px solid var(--accent);
    border-radius: 0 8px 8px 0;
  }
  .lesson :global(blockquote p) {
    margin: 0;
  }
  .lesson :global(code) {
    background: var(--surface-2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .lesson :global(ul.contains-task-list) {
    list-style: none;
    padding-left: 0;
  }
  .lesson :global(h2) {
    scroll-margin-top: 72px;
  }
  .lesson :global(h3) {
    margin-top: 1.6rem;
  }
  .lesson :global(h4) {
    font-size: 1rem;
    margin: 1.2rem 0 0.4rem;
  }
  .lesson :global(li + li) {
    margin-top: 4px;
  }
  .lesson :global(figure.diagram) {
    margin: 20px 0;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow-x: auto;
    text-align: center;
  }
  .lesson :global(figure.diagram svg) {
    height: auto;
  }
  .lesson :global(.diagram-hint) {
    position: sticky;
    left: 0;
    margin-top: 8px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .lesson :global(pre:has(> code.language-mermaid)) {
    min-height: 120px;
    color: transparent;
    background: var(--surface-2);
    border-radius: 10px;
    overflow: hidden;
  }
  .lesson :global(.callout) {
    margin: 20px 0;
    padding: 14px 16px 14px 18px;
    border-radius: 10px;
    border-left: 5px solid var(--accent);
    background: var(--accent-soft);
  }
  .lesson :global(.callout > :first-child) {
    margin-top: 0;
  }
  .lesson :global(.callout > :last-child) {
    margin-bottom: 0;
  }
  .lesson :global(.callout-title) {
    font-weight: 700;
    margin-bottom: 4px;
  }
  .lesson :global(.callout.tip) {
    border-color: var(--success);
    background: var(--success-soft);
  }
  .lesson :global(.callout.trap) {
    border-color: var(--danger);
    background: var(--danger-soft);
  }
  .lesson :global(.callout.why) {
    border-color: var(--warning);
    background: var(--warning-soft);
  }
  .lesson :global(.callout.handson) {
    border-color: var(--step-3);
    background: var(--surface-2);
  }
  .lesson :global(.callout.example) {
    border-color: var(--step-2);
    background: var(--surface-2);
  }
  .objectives {
    margin-top: 12px;
  }
  .study {
    margin: 8px 0 0;
    padding: 12px 16px;
  }
  .study-total {
    margin: 0 0 4px;
  }
  .study-list {
    margin: 0 0 4px;
    padding-left: 1.2em;
  }
  .objectives summary {
    font-weight: 700;
    cursor: pointer;
  }
  .objectives ol {
    margin: 8px 0;
    padding-left: 1.4em;
    font-size: 0.92rem;
  }
  .objectives li + li {
    margin-top: 6px;
  }
  .toc summary {
    font-weight: 700;
    cursor: pointer;
  }
  .toc ol {
    margin: 8px 0 0;
    padding-left: 1.4em;
    columns: 2 240px;
    font-size: 0.92rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
  }
  .done-toggle {
    display: flex;
    gap: 8px;
    align-items: center;
    font-weight: 600;
    cursor: pointer;
  }
  .done-toggle input {
    width: 20px;
    height: 20px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
</style>
