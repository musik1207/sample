---
import Base from '../../../layouts/Base.astro';
import { certs, steps, url, certSummaries, getLessonKeys, domainStudyHours, formatHours, displayName, scoreLine, getCases } from '../../../lib/data';
import type { Cert } from '../../../lib/types';

export function getStaticPaths() {
  return certs.map((cert) => ({ params: { id: cert.id }, props: { cert } }));
}

const { cert } = Astro.props as { cert: Cert };
const step = steps.find((s) => s.id === cert.step)!;
const lessonKeys = await getLessonKeys();
const summary = certSummaries(lessonKeys).find((s) => s.id === cert.id)!;
const hasQuestions = summary.questions.length > 0;
const show = (v: string | number | null, suffix = '') => (v === null ? '要確認' : `${v}${suffix}`);
const shortName = displayName(cert);
const passing = cert.exam.passingScore;
const line = scoreLine(cert);
const fullMock = Math.min(cert.exam.questions ?? 60, summary.questions.length);
const hasCases = Object.keys(getCases(cert.id)).length > 0;
const taskCount = summary.domains.reduce((s, d) => s + d.tasks.length, 0);
---

<Base title={shortName}>
  <nav class="breadcrumb" aria-label="現在の位置">
    <a href={url()}>ロードマップ</a><span aria-hidden="true">›</span><span>STEP {step.id} {step.title}</span>
  </nav>

  <header class="cert-head" style={`--step-color: var(--step-${step.id})`}>
    <h1>{shortName}</h1>
    {
      (cert.name !== shortName || cert.formerName) && (
        <p class="small muted official">
          {cert.name}
          {cert.formerName && `（旧: ${cert.formerName.replace('Salesforce Certified ', '')}）`}
        </p>
      )
    }
    <p class="summary">{cert.summary}</p>
  </header>

  {
    cert.status === 'outline' && (
      <p class="notice">
        この資格は<strong>試験概要のみ</strong>です。教材と練習問題は順次追加します。出題範囲・配点は公式試験ガイドで確定させる前の想定です。
      </p>
    )
  }

  <section class="card plan" aria-labelledby="plan-title" style={`--step-color: var(--step-${step.id})`}>
    <h2 id="plan-title" class="visually-hidden">進み具合と受験計画</h2>
    <div class="plan-progress">
      <p class="plan-percent"><strong id="overall-percent">0%</strong><span class="small muted"> 完了</span></p>
      <div class="progress thick" aria-hidden="true"><span id="overall-bar"></span></div>
      <p class="small muted" id="overall-detail"></p>
    </div>

    <div class="btn-row stack plan-actions" id="plan-actions">
      {
        hasQuestions && (
          <>
            <a class="btn" href={url(`certs/${cert.id}/quiz/?mode=mock`)}>
              模擬試験（{fullMock} 問）
            </a>
            <a class="btn" href={url(`certs/${cert.id}/quiz/?mode=all`)}>
              全範囲から演習
            </a>
          </>
        )
      }
    </div>

    <div class="weak" id="weak" hidden></div>

    <div class="plan-dates">
      <label class="field">
        <span class="small muted">受験目標日</span>
        <input type="date" id="target-date" />
      </label>
      <label class="field">
        <span class="small muted">合格した日</span>
        <input type="date" id="passed-date" />
      </label>
      <p class="small countdown" id="countdown" aria-live="polite"></p>
    </div>

    <div id="mock-history"></div>
  </section>

  {
    hasQuestions && (
      <section class="card ready" aria-labelledby="ready-title">
        <div class="ready-head">
          <h2 id="ready-title">合格の準備度</h2>
          <span class="tag" id="ready-badge" />
        </div>
        <p class="small muted ready-note">
          すべて達成したら受験の目安です。
          {line.label === '目安'
            ? `合格点が公表されていないため、正答率 ${line.value}% を基準にしています。`
            : `基準は合格ライン（${line.value}%）です。`}
          初見の正答率は、問題を初めて解いたときの結果で計算します。
        </p>
        <ul class="ready-list" id="ready-list" />
        <div class="btn-row">
          <a class="btn btn-sm" id="new-btn" href={url(`certs/${cert.id}/quiz/?mode=new`)}>
            まだ解いていない問題
          </a>
          {hasCases && (
            <a class="btn btn-sm" href={url(`certs/${cert.id}/quiz/?mode=case`)}>
              事例（ケース）問題
            </a>
          )}
          <a class="btn btn-sm" href={url('review/')}>
            今日の復習
          </a>
        </div>
        {taskCount > 0 && (
          <details class="tasks">
            <summary>タスク別の正答率（{taskCount} タスク）</summary>
            <ol class="task-list" id="task-list" />
          </details>
        )}
      </section>
    )
  }

  <h2 class="section-title">出題範囲</h2>
  <ol class="list domains">
    {
      cert.domains.map((d, i) => {
        const hasLesson = lessonKeys.has(`${cert.id}/${d.id}`);
        const qCount = summary.questions.filter((q) => q.domain === d.id).length;
        const hours = domainStudyHours(cert, d.id);
        return (
          <li class:list={['domain', { 'row-link': hasLesson }]} data-domain={d.id}>
            <span class="domain-no" data-mark aria-hidden="true">
              {i + 1}
            </span>
            <div class="domain-main">
              <div class="domain-title">
                {hasLesson ? (
                  <a class="stretched" href={url(`certs/${cert.id}/${d.id}/`)}>
                    {d.name}
                  </a>
                ) : (
                  <span>{d.name}</span>
                )}
                <span class="weight">{d.weight === null ? '配点 要確認' : `${d.weight}%`}</span>
              </div>
              <p class="small muted domain-sub">
                {d.nameEn}
                {hours !== null && ` ・ 約 ${formatHours(hours)}`}
              </p>
              {(hasLesson || qCount > 0) && (
                <div class="domain-status">
                  <div class="progress" aria-hidden="true">
                    <span data-bar />
                  </div>
                  <span class="small muted" data-status />
                </div>
              )}
            </div>
            {qCount > 0 && (
              <a class="btn btn-sm above domain-quiz" href={url(`certs/${cert.id}/quiz/?domain=${d.id}`)}>
                問題 {qCount}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>

  <h2 class="section-title">試験の概要</h2>
  <section class="card exam" aria-label="試験の概要">
    <div class="stats">
      <div class="stat"><span class="stat-label">問題数</span><span class="stat-value">{show(cert.exam.questions)}<small>問</small></span></div>
      <div class="stat"><span class="stat-label">試験時間</span><span class="stat-value">{show(cert.exam.minutes)}<small>分</small></span></div>
      <div class="stat">
        <span class="stat-label">合格ライン</span>
        <span class="stat-value">{passing === null ? (cert.exam.passingNote ?? '要確認') : passing}{passing !== null && <small>%</small>}</span>
      </div>
      {cert.study && <div class="stat"><span class="stat-label">学習時間の目安</span><span class="stat-value">{cert.study.hours}<small>時間</small></span></div>}
    </div>
    <details class="exam-more">
      <summary>受験料・前提条件・注意点</summary>
      <div class="table-wrap">
        <table>
          <tbody>
            <tr><th scope="row">受験料</th><td>{show(cert.exam.fee)}</td></tr>
            <tr><th scope="row">再受験料</th><td>{show(cert.exam.retakeFee)}</td></tr>
            <tr><th scope="row">前提条件</th><td>{cert.exam.prerequisite}</td></tr>
          </tbody>
        </table>
      </div>
      {cert.study && <p class="small">学習時間の目安について: {cert.study.note}各範囲の時間は配点で割り振っています。</p>}
      <ul class="small notes">
        {cert.exam.notes.map((n) => <li>{n}</li>)}
      </ul>
      <p class="small muted">情報の確認日: {cert.exam.checkedAt}（{cert.exam.verified ? '公式情報と照合済み' : '未確定'}）</p>
    </details>
    {
      cert.links.length > 0 && (
        <ul class="links small">
          {cert.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer">
                {l.label}
                <span class="visually-hidden">（新しいタブで開く）</span> ↗
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <script type="application/json" id="cert-data" set:html={JSON.stringify(summary)} />
  <script type="application/json" id="cert-line" set:html={JSON.stringify({ ...line, fullMock })} />
  <script>
    import type { CertSummary } from '../../../lib/data';
    import { getReadingPos, loadProgress, setPlan } from '../../../lib/storage';
    import { certProgress, daysLabel, daysUntil, domainAccuracy, nextAction, paceText, readiness, readJson, weakDomains } from '../../../lib/progress';

    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const cert = readJson<CertSummary>('cert-data');
    const line = readJson<{ value: number; label: string; fullMock: number }>('cert-line');
    const targetInput = document.getElementById('target-date') as HTMLInputElement;
    const passedInput = document.getElementById('passed-date') as HTMLInputElement;
    const $ = (id: string) => document.getElementById(id)!;
    const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    /** 合格の準備度とタスク別の正答率 */
    function renderReadiness(data: ReturnType<typeof loadProgress>) {
      const list = document.getElementById('ready-list');
      if (!list) return;
      const r = readiness(cert, data, line.value, line.fullMock);
      list.innerHTML = r.checks
        .map(
          (c) => `<li class="${c.ok ? 'ok' : ''}">
            <span class="ready-mark" aria-hidden="true">${c.ok ? '✓' : ''}</span>
            <span class="ready-label">${c.label}</span>
            <span class="ready-value">${escape(c.value)}</span>
            <span class="ready-target">${escape(c.target)}</span>
            <span class="visually-hidden">${c.ok ? '達成' : '未達成'}</span>
          </li>`,
        )
        .join('');
      const done = r.checks.filter((c) => c.ok).length;
      const badge = $('ready-badge');
      badge.textContent = r.ready ? '受験の準備ができています' : `${done} / ${r.checks.length} 達成`;
      badge.className = `tag ${r.ready ? 'tag-success' : ''}`;
      const unseen = cert.questions.filter((q) => !data.questions[q.id]).length;
      const newBtn = $('new-btn');
      newBtn.textContent = `まだ解いていない問題（${unseen} 問）`;
      newBtn.hidden = unseen === 0;
      const tasks = document.getElementById('task-list');
      if (tasks) {
        tasks.innerHTML = r.units
          .filter((u) => u.task !== null && u.total > 0)
          .map((u) => {
            const ok = u.answered >= 5 && (u.rate ?? 0) >= line.value;
            const domain = cert.domains.find((d) => d.id === u.domainId)?.name.replace(/（.*）/, '') ?? '';
            return `<li class="${ok ? 'ok' : u.answered ? 'weak' : ''}">
              <div class="task-main">
                <span class="task-name"><span class="muted">${escape(domain)}</span> ${escape(u.label)}</span>
                <span class="task-rate">${u.rate === null ? '—' : `${u.rate}%`}<small> ${u.answered}/${u.total} 問</small></span>
              </div>
              <div class="progress" aria-hidden="true"><span style="width:${u.rate ?? 0}%"></span></div>
              <a class="small" href="${base}/certs/${cert.id}/quiz/?task=${u.domainId}-${u.task}">このタスクを練習 →</a>
            </li>`;
          })
          .join('');
      }
    }

    function render() {
      const data = loadProgress();
      const plan = data.plans[cert.id] ?? {};
      targetInput.value = plan.targetDate ?? cert.suggestedTarget ?? '';
      passedInput.value = plan.passedDate ?? '';

      const p = certProgress(cert, data);
      renderReadiness(data);
      $('overall-percent').textContent = `${p.percent}%`;
      $('overall-bar').style.width = `${p.percent}%`;
      $('overall-detail').textContent = `レッスン ${p.lessonsDone}/${p.lessonsTotal} ・ 正解した問題 ${p.mastered}/${p.questionsTotal} ・ 復習待ち ${p.reviewCount} 問`;

      // 受験目標
      const countdown = $('countdown');
      if (plan.passedDate) countdown.textContent = '合格おめでとうございます！';
      else if (targetInput.value) {
        const d = daysUntil(targetInput.value);
        countdown.textContent = [`受験目標まで${d >= 0 ? '' : '：'}${daysLabel(d)}`, paceText(cert.studyHours, p.percent, d)].filter(Boolean).join('。');
      } else countdown.textContent = '受験目標日を決めると、1 日あたりのペースを計算します。';

      // 次にやること（読みかけのレッスンを優先）
      const actions = $('plan-actions');
      actions.querySelector('[data-next]')?.remove();
      const reading = cert.lessonDomains
        .filter((d) => !data.lessons[`${cert.id}/${d}`])
        .map((d) => ({ d, pos: getReadingPos(`${cert.id}/${d}`) }))
        .find((r) => r.pos);
      const next = nextAction(cert, data, base);
      const primary = reading
        ? {
            label: `続きを読む: ${cert.domains.find((x) => x.id === reading.d)?.name ?? reading.d}`,
            href: `${base}/certs/${cert.id}/${reading.d}/#${reading.pos!.heading}`,
          }
        : next;
      if (primary && !plan.passedDate) {
        const a = document.createElement('a');
        a.className = 'btn btn-primary';
        a.dataset.next = '';
        a.href = primary.href;
        a.textContent = primary.label;
        actions.prepend(a);
      }

      // 苦手な範囲
      const weak = weakDomains(cert, data, line.value);
      const weakEl = $('weak');
      weakEl.hidden = weak.length === 0;
      weakEl.innerHTML = weak.length
        ? `<p class="small weak-title">苦手な範囲（正答率が${line.label} ${line.value}% 未満）</p><div class="btn-row">${weak
            .slice(0, 3)
            .map(
              (d) =>
                `<a class="btn btn-sm" href="${base}/certs/${cert.id}/quiz/?domain=${d.id}">${escape(d.name)} <span class="tag tag-danger">${d.acc.rate}%</span></a>`,
            )
            .join('')}</div>`
        : '';

      // 出題範囲ごとの状態
      for (const d of cert.domains) {
        const el = document.querySelector<HTMLElement>(`[data-domain="${d.id}"]`);
        if (!el) continue;
        const dp = certProgress(cert, data, d.id);
        const acc = domainAccuracy(cert, data, d.id);
        const parts: string[] = [];
        if (dp.lessonsTotal) parts.push(dp.lessonsDone ? '読了' : 'レッスン未読');
        if (dp.questionsTotal) parts.push(`正解 ${dp.mastered}/${dp.questionsTotal}`);
        if (acc.rate !== null) parts.push(`正答率 ${acc.rate}%`);
        const status = el.querySelector<HTMLElement>('[data-status]');
        if (status) status.textContent = parts.join(' ・ ');
        const bar = el.querySelector<HTMLElement>('[data-bar]');
        if (bar) bar.style.width = `${dp.percent}%`;
        el.dataset.state = dp.percent === 100 ? 'done' : dp.lessonsDone ? 'read' : 'todo';
        el.classList.toggle('is-weak', acc.answered >= 5 && acc.rate !== null && acc.rate < line.value);
      }

      // 模擬試験の履歴
      const mocks = data.mocks.filter((m) => m.certId === cert.id).slice(-5).reverse();
      $('mock-history').innerHTML = mocks.length
        ? `<p class="small muted mock-title">模擬試験の結果（直近 ${mocks.length} 回）</p><ul class="mock-list">${mocks
            .map((m) => {
              const pct = Math.round((m.score / m.total) * 100);
              const ok = pct >= line.value;
              return `<li><span class="tag ${ok ? 'tag-success' : 'tag-danger'}">${pct}%</span><span class="small muted">${m.date.slice(5, 10).replace('-', '/')}</span></li>`;
            })
            .join('')}</ul>`
        : '';
    }

    targetInput.addEventListener('change', () => {
      setPlan(cert.id, { targetDate: targetInput.value });
      render();
    });
    passedInput.addEventListener('change', () => {
      setPlan(cert.id, { passedDate: passedInput.value });
      render();
    });
    render();
  </script>
</Base>

<style>
  .cert-head h1 {
    margin-bottom: 2px;
  }
  .official {
    margin: 0 0 8px;
  }
  .summary {
    margin: 0 0 20px;
    max-width: 46em;
  }
  .plan {
    display: grid;
    gap: 16px;
    border-top: 4px solid var(--step-color);
  }
  .plan-percent {
    margin: 0 0 6px;
    font-size: 1.6rem;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .plan-progress .progress > span {
    background: var(--step-color);
  }
  .plan-progress p:last-child {
    margin: 6px 0 0;
  }
  .weak {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--danger-soft);
  }
  .weak :global(.weak-title) {
    margin: 0 0 8px;
    font-weight: 700;
    color: var(--danger);
  }
  .ready {
    margin-top: 16px;
  }
  .ready-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .ready-head h2 {
    margin: 0;
    font-size: 1.1rem;
  }
  .ready-note {
    margin: 4px 0 12px;
  }
  .ready-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    display: grid;
    gap: 6px;
  }
  .ready-list :global(li) {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    grid-template-areas: 'mark label value' 'mark target target';
    column-gap: 8px;
    align-items: baseline;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .ready-list :global(li.ok) {
    background: var(--success-soft);
  }
  .ready-list :global(.ready-mark) {
    grid-area: mark;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    border: 2px solid var(--border-strong);
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    align-self: center;
  }
  .ready-list :global(li.ok .ready-mark) {
    background: var(--success);
    border-color: var(--success);
    color: var(--surface);
  }
  .ready-list :global(.ready-label) {
    grid-area: label;
    font-weight: 600;
  }
  .ready-list :global(.ready-value) {
    grid-area: value;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .ready-list :global(.ready-target) {
    grid-area: target;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .tasks {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .tasks summary {
    font-weight: 600;
  }
  .task-list {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 12px;
  }
  .task-list :global(li) {
    display: grid;
    gap: 4px;
  }
  .task-list :global(.task-main) {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
  }
  .task-list :global(.task-name) {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .task-list :global(.task-rate) {
    font-weight: 700;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .task-list :global(.task-rate small) {
    font-weight: 400;
    color: var(--text-muted);
  }
  .task-list :global(li.weak .task-rate) {
    color: var(--danger);
  }
  .task-list :global(li.weak .progress > span) {
    background: var(--danger);
  }
  .task-list :global(li.ok .progress > span) {
    background: var(--success);
  }
  .plan-dates {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: flex-end;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .field {
    display: grid;
    gap: 2px;
  }
  .countdown {
    flex: 1 1 100%;
    margin: 0;
  }
  #mock-history:empty {
    display: none;
  }
  #mock-history :global(.mock-title) {
    margin: 0 0 6px;
  }
  #mock-history :global(.mock-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  #mock-history :global(.mock-list li) {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .domain {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 14px 16px;
  }
  .domain-no {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    background: var(--surface-2);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .domain[data-state='read'] .domain-no {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .domain[data-state='done'] .domain-no {
    background: var(--success);
    color: var(--surface);
  }
  .domain-title {
    display: flex;
    gap: 8px;
    align-items: baseline;
    justify-content: space-between;
    font-weight: 700;
  }
  .weight {
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .domain-sub {
    margin: 0;
  }
  .domain-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
  }
  .domain-status .progress {
    width: 96px;
    flex-shrink: 0;
  }
  .domain[data-state='done'] .progress > span {
