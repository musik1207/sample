---
import Base from '../layouts/Base.astro';
import { certs, glossary } from '../lib/data';

const terms = glossary.slice().sort((a, b) => a.term.localeCompare(b.term, 'ja'));
const certName = (id: string) => certs.find((c) => c.id === id)?.name.replace('Salesforce Certified ', '') ?? id;
const usedCerts = certs.filter((c) => terms.some((t) => t.certs.includes(c.id)));
---

<Base title="用語集" nav="glossary">
  <h1>用語集</h1>
  <p class="muted intro">{terms.length} 語。資格をまたいで検索できます。</p>
  <div class="filters" role="search">
    <label class="visually-hidden" for="q">用語を検索</label>
    <input type="search" id="q" placeholder="用語・説明を検索（例: 共有、Flow）" />
    <label class="visually-hidden" for="cert">資格で絞り込み</label>
    <select id="cert">
      <option value="">すべての資格</option>
      {usedCerts.map((c) => <option value={c.id}>{c.name.replace('Salesforce Certified ', '')}</option>)}
    </select>
  </div>
  <p class="small muted count" id="count" aria-live="polite"></p>
  <dl class="terms list">
    {
      terms.map((t) => (
        <div class="term" data-certs={t.certs.join(' ')} data-text={`${t.term} ${t.reading ?? ''} ${t.description} ${(t.tags ?? []).join(' ')}`.toLowerCase()}>
          <dt>
            {t.term}
            {t.reading && <span class="muted small reading">{t.reading}</span>}
          </dt>
          <dd>
            <p>{t.description}</p>
            <div class="tags">
              {t.tags?.map((tag) => <span class="tag">{tag}</span>)}
              {t.certs.map((c) => <span class="tag">{certName(c)}</span>)}
            </div>
          </dd>
        </div>
      ))
    }
  </dl>
  <div class="card empty" id="empty" hidden>
    <h2>見つかりませんでした</h2>
    <p class="muted">別のことばで試すか、資格の絞り込みを外してください。</p>
    <div class="btn-row"><button class="btn" type="button" id="clear">条件をクリア</button></div>
  </div>
  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const cert = document.getElementById('cert') as HTMLSelectElement;
    const items = [...document.querySelectorAll<HTMLElement>('.term')];
    const count = document.getElementById('count')!;
    function filter() {
      const word = q.value.trim().toLowerCase();
      let shown = 0;
      for (const el of items) {
        const ok = (!word || el.dataset.text!.includes(word)) && (!cert.value || el.dataset.certs!.split(' ').includes(cert.value));
        el.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = word || cert.value ? `${shown} 件見つかりました` : `${shown} 件`;
      document.getElementById('empty')!.hidden = shown > 0;
      document.querySelector<HTMLElement>('.terms')!.hidden = shown === 0;
      // 検索語を URL に残して、戻ったときや共有したときに同じ結果を出す
      const params = new URLSearchParams();
      if (q.value.trim()) params.set('q', q.value.trim());
      if (cert.value) params.set('cert', cert.value);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }
    const initial = new URLSearchParams(location.search);
    q.value = initial.get('q') ?? '';
    cert.value = initial.get('cert') ?? '';
    q.addEventListener('input', filter);
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        q.value = '';
        filter();
      }
    });
    cert.addEventListener('change', filter);
    document.getElementById('clear')!.addEventListener('click', () => {
      q.value = '';
      cert.value = '';
      filter();
      q.focus();
    });
    // 「/」キーで検索欄へ
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== q) {
        e.preventDefault();
        q.focus();
      }
    });
    filter();
  </script>
</Base>

<style>
  .intro {
    margin: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px -16px 0;
    padding: 10px 16px;
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .count {
    margin: 4px 0 8px;
  }
  .filters input {
    flex: 1 1 240px;
  }
  .terms {
    margin: 0;
  }
  .term {
    padding: 14px 18px;
  }
  /* 絞り込みで先頭が隠れても線が二重にならないよう、上の線をはみ出させて隠す */
  .term {
    border-top: 1px solid var(--border);
    margin-top: -1px;
  }
  .term[hidden] {
    display: none;
  }
  dt {
    font-weight: 700;
  }
  .reading {
    margin-left: 8px;
    font-weight: 400;
  }
  dd {
    margin: 0;
  }
  dd p {
    margin: 4px 0 8px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
</style>
