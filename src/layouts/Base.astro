---
import '../styles/global.css';
import { url } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  nav?: 'home' | 'review' | 'glossary' | 'settings';
  /** レッスンのように横に目次を置くページは広めにする */
  wide?: boolean;
}

const { title, description = 'PMP と Salesforce 認定資格の学習サイト', nav, wide = false } = Astro.props;

// アイコンは線だけのシンプルなもの（24×24）
const icons = {
  home: '<path d="M9 4 3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5z"/><path d="M9 4v13.5M15 6.5V20"/>',
  review: '<path d="M3 12a9 9 0 1 0 2.6-6.4L3 8"/><path d="M3 3v5h5"/><path d="M12 8v4l3 2"/>',
  glossary: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/>',
  settings: '<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>',
};

const navItems = [
  { key: 'home', label: 'ロードマップ', short: 'ホーム', href: url() },
  { key: 'review', label: '復習', short: '復習', href: url('review/') },
  { key: 'glossary', label: '用語集', short: '用語集', href: url('glossary/') },
  { key: 'settings', label: '記録と設定', short: '設定', href: url('settings/') },
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161d25" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <!-- ホーム画面に追加したときのアプリ（Web アプリ）としての設定 -->
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="資格マップ" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <!-- 起動画面（iPhone Air: 420×912pt・3 倍） -->
    <link
      rel="apple-touch-startup-image"
      media="screen and (device-width: 420px) and (device-height: 912px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: light)"
      href={url('splash/iphone-air-light.png')}
    />
    <link
      rel="apple-touch-startup-image"
      media="screen and (device-width: 420px) and (device-height: 912px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait) and (prefers-color-scheme: dark)"
      href={url('splash/iphone-air-dark.png')}
    />
    <title>{title === '資格ロードマップ' ? title : `${title} | 資格ロードマップ`}</title>
    <script is:inline>
      // 画面が描かれる前にテーマと文字サイズを反映して、ちらつきを防ぐ
      try {
        var p = JSON.parse(localStorage.getItem('sf-cert-study:prefs') || '{}');
        if (p.theme === 'light' || p.theme === 'dark') {
          document.documentElement.dataset.theme = p.theme;
          // ステータスバーなどの色も、選んだテーマに合わせる
          var tc = { light: '#ffffff', dark: '#161d25' };
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.setAttribute('content', tc[p.theme]);
          });
        }
        if (p.size === 'large') document.documentElement.dataset.size = 'large';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class:list={['container', { wide }]}>
        <a class="brand" href={url()}>
          <img src={url('favicon.svg')} alt="" width="24" height="24" />
          資格ロードマップ
        </a>
        <nav class="site-nav" aria-label="メインメニュー">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={nav === item.key ? 'page' : undefined}>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons[item.key]}
                />
                <span class="nav-label">
                  <span class="nav-long">{item.label}</span>
                  <span class="nav-short">{item.short}</span>
                </span>
                {item.key === 'review' && <span class="badge-count" data-review-count aria-label="復習待ちの問題数" />}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main" class:list={['container', { wide }]} tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class:list={['container', { wide }]}>
        個人の学習用サイトです。練習問題はすべてオリジナルで、実際の試験問題ではありません。試験の最新情報は必ず各資格の公式情報（Salesforce は Trailhead、PMP は PMI）で確認してください。
      </div>
    </footer>
    <script>
      import { isDue, loadProgress } from '../lib/storage';
      import { registerServiceWorker } from '../lib/pwa';
      registerServiceWorker();
      // メニューのバッジは「今日の復習」の数
      const count = Object.values(loadProgress().questions).filter((q) => isDue(q)).length;
      document.querySelectorAll<HTMLElement>('[data-review-count]').forEach((el) => {
        el.textContent = count > 0 ? String(count) : '';
      });
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  .nav-short {
    display: none;
  }
  @media (min-width: 720px) {
    .site-nav svg {
      display: none;
    }
  }
  @media (max-width: 719px) {
    .nav-long {
      display: none;
    }
    .nav-short {
      display: inline;
    }
  }
</style>
